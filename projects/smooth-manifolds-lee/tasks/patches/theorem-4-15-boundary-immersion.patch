+private def boundaryImmersionChartPartialDiffeomorph
+    (e : OpenPartialHomeomorph M (EuclideanHalfSpace m))
+    (he : e ∈ IsManifold.maximalAtlas J_m ∞ M) :
+    PartialDiffeomorph J_m J_m M (EuclideanHalfSpace m) ∞ where
+  toPartialEquiv := e.toPartialEquiv
+  open_source := e.open_source
+  open_target := e.open_target
+  contMDiffOn_toFun := contMDiffOn_of_mem_maximalAtlas he
+  contMDiffOn_invFun := contMDiffOn_symm_of_mem_maximalAtlas he
+
+private theorem boundaryImmersionChart_maps_boundary
+    (e : OpenPartialHomeomorph M (EuclideanHalfSpace m))
+    (he : e ∈ IsManifold.maximalAtlas J_m ∞ M)
+    {p : M} (hep : p ∈ e.source) (hp : p ∈ (𝓡∂ m).boundary M) :
+    (e p).1 0 = 0 := by
+  have hlocal : IsLocalDiffeomorphAt J_m J_m ∞ e p := by
+    exact PartialDiffeomorph.isLocalDiffeomorphAt
+      (I := J_m) (J := J_m) (M := M) (N := EuclideanHalfSpace m)
+      (n := ∞) (boundaryImmersionChartPartialDiffeomorph e he) hep
+  have heboundary : (𝓡∂ m).IsBoundaryPoint (e p) :=
+    (hlocal.isBoundaryPoint_iff (by simp)).mp hp
+  rw [(𝓡∂ m).isBoundaryPoint_iff,
+    frontier_range_modelWithCornersEuclideanHalfSpace m] at heboundary
+  exact heboundary.symm
+
+private noncomputable def boundaryImmersionHalfSpaceAddRight
+    (a : EuclideanHalfSpace m) (ha : a.1 0 = 0) :
+    EuclideanHalfSpace m ≃ₜ EuclideanHalfSpace m :=
+  (Homeomorph.addRight (-a.1)).subtype (by
+    intro x
+    simp [ha])
+
+@[simp] private theorem boundaryImmersionHalfSpaceAddRight_apply_val
+    (a x : EuclideanHalfSpace m) (ha : a.1 0 = 0) :
+    (boundaryImmersionHalfSpaceAddRight a ha x).1 = x.1 - a.1 := by
+  rfl
+
+@[simp] private theorem boundaryImmersionHalfSpaceAddRight_symm_apply_val
+    (a x : EuclideanHalfSpace m) (ha : a.1 0 = 0) :
+    ((boundaryImmersionHalfSpaceAddRight a ha).symm x).1 = x.1 + a.1 := by
+  change (Homeomorph.addRight (-a.1)).symm x.1 = x.1 + a.1
+  change x.1 + -(-a.1) = x.1 + a.1
+  simp
+
+private theorem boundaryImmersionHalfSpaceAddRight_mem_contDiffGroupoid
+    (a : EuclideanHalfSpace m) (ha : a.1 0 = 0) :
+    (boundaryImmersionHalfSpaceAddRight a ha).toOpenPartialHomeomorph ∈
+      contDiffGroupoid ∞ (𝓡∂ m) := by
+  rw [contDiffGroupoid, mem_groupoid_of_pregroupoid, contDiffPregroupoid]
+  constructor
+  · have hsmooth : ContDiff ℝ ∞
+        (fun x : EuclideanSpace ℝ (Fin m) ↦ x - a.1) :=
+      contDiff_id.sub contDiff_const
+    apply hsmooth.contDiffOn.congr
+    intro x hx
+    have hxrange : x ∈ Set.range (𝓡∂ m) := hx.2
+    have hright : ((𝓡∂ m).symm x).1 = x := by
+      simpa using (𝓡∂ m).right_inv hxrange
+    change ((boundaryImmersionHalfSpaceAddRight a ha ((𝓡∂ m).symm x)).1) =
+      x - a.1
+    rw [boundaryImmersionHalfSpaceAddRight_apply_val, hright]
+  · have hsmooth : ContDiff ℝ ∞
+        (fun x : EuclideanSpace ℝ (Fin m) ↦ x + a.1) :=
+      contDiff_id.add contDiff_const
+    apply hsmooth.contDiffOn.congr
+    intro x hx
+    have hxrange : x ∈ Set.range (𝓡∂ m) := hx.2
+    have hright : ((𝓡∂ m).symm x).1 = x := by
+      simpa using (𝓡∂ m).right_inv hxrange
+    change (((boundaryImmersionHalfSpaceAddRight a ha).symm
+      ((𝓡∂ m).symm x)).1) = x + a.1
+    rw [boundaryImmersionHalfSpaceAddRight_symm_apply_val, hright]
