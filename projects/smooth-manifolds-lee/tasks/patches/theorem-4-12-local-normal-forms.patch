+private noncomputable def immersionStandardTargetSplit {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    EuclideanSpace ℝ (Fin n) ≃L[ℝ]
+      EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin (n - m)) := by
+  have hsum : m + (n - m) = n := Nat.add_sub_of_le (immersionSourceDim_le h)
+  exact
+    (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (finCongr hsum.symm)).toContinuousLinearEquiv.trans
+      (EuclideanSpace.finAddEquivProd (𝕜 := ℝ) (n := m) (m := n - m))
