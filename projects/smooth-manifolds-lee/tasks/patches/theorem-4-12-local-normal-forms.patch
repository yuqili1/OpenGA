+/- The following helpers turn the inverse-function normal coordinates attached to a surjective
+derivative into the standard Euclidean ordering with target coordinates first. -/
+
+private noncomputable def submersionDerivative (F : M → N) (p : M) :
+    EuclideanSpace ℝ (Fin m) →L[ℝ] EuclideanSpace ℝ (Fin n) :=
+  mfderiv I_m I_n F p
+
+private theorem submersionTargetDim_le {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) : n ≤ m := by
+  simpa only [finrank_euclideanSpace_fin] using
+    (LinearMap.finrank_le_finrank_of_surjective
+      (f := (submersionDerivative (m := m) (n := n) F p).toLinearMap)
+      (by simpa [submersionDerivative] using hF.surjective_mfderiv p))
+
+private theorem submersionKernelFinrankEq {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    Module.finrank ℝ (submersionDerivative (m := m) (n := n) F p).ker = m - n := by
+  let L := submersionDerivative (m := m) (n := n) F p
+  have hsurj : Function.Surjective L := by
+    simpa [L, submersionDerivative] using hF.surjective_mfderiv p
+  have hrange : L.range = ⊤ := LinearMap.range_eq_top.mpr hsurj
+  have hrange_finrank : Module.finrank ℝ L.range = n := by
+    rw [hrange, finrank_top]
+    exact finrank_euclideanSpace_fin
+  have hsum : n + Module.finrank ℝ L.ker = m := by
+    have hraw := L.toLinearMap.finrank_range_add_finrank_ker
+    rw [hrange_finrank] at hraw
+    simpa only [finrank_euclideanSpace_fin] using hraw
+  apply Nat.eq_sub_of_add_eq
+  simpa only [Nat.add_comm] using hsum
+
+private noncomputable def submersionKernelEuclideanEquiv {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    (submersionDerivative (m := m) (n := n) F p).ker ≃L[ℝ]
+      EuclideanSpace ℝ (Fin (m - n)) := by
+  apply ContinuousLinearEquiv.ofFinrankEq
+  simpa only [finrank_euclideanSpace_fin] using submersionKernelFinrankEq p hF
+
+private noncomputable def submersionStandardSourceSplit {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    EuclideanSpace ℝ (Fin m) ≃L[ℝ]
+      EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin (m - n)) := by
+  have hsum : n + (m - n) = m := Nat.add_sub_of_le (submersionTargetDim_le p hF)
+  exact
+    (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (finCongr hsum.symm)).toContinuousLinearEquiv.trans
+      (EuclideanSpace.finAddEquivProd (𝕜 := ℝ) (n := n) (m := m - n))
+
+private noncomputable def submersionStandardSourceJoin {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    (EuclideanSpace ℝ (Fin n) × EuclideanSpace ℝ (Fin (m - n)))
+      ≃L[ℝ] EuclideanSpace ℝ (Fin m) :=
+  (submersionStandardSourceSplit p hF).symm
+
+private theorem submersionRankNormalForm_join {F : M → N} {p : M}
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F)
+    (u : EuclideanSpace ℝ (Fin n)) (v : EuclideanSpace ℝ (Fin (m - n))) :
+    rank_normal_form m n n (submersionStandardSourceJoin p hF (u, v)) = u := by
+  have hnm : n ≤ m := submersionTargetDim_le p hF
+  have hsum : n + (m - n) = m := Nat.add_sub_of_le hnm
+  ext i
+  rw [rank_normal_form_apply_of_lt i.2 (lt_of_lt_of_le i.2 hnm)]
+  simp [submersionStandardSourceJoin, submersionStandardSourceSplit,
+    LinearEquiv.prodCongr_symm, LinearEquiv.prodCongr_apply,
+    WithLp.linearEquiv_apply]
+  have hcast :
+      Fin.cast hsum.symm ⟨i.1, lt_of_lt_of_le i.2 hnm⟩ =
+        Fin.castAdd (m - n) i := by
+    ext
+    rfl
+  change Sum.rec u.ofLp v.ofLp
+      (finSumFinEquiv.symm
+        (Fin.cast hsum.symm ⟨i.1, lt_of_lt_of_le i.2 hnm⟩)) = u.ofLp i
+  rw [hcast, finSumFinEquiv_symm_apply_castAdd]
+
+private noncomputable def submersionKernelProjection {F : M → N} (p : M) :
+    EuclideanSpace ℝ (Fin m) →L[ℝ]
+      (submersionDerivative (m := m) (n := n) F p).ker :=
+  Classical.choose
+    (submersionDerivative (m := m) (n := n) F p).ker_closedComplemented_of_finiteDimensional_range
+
+private theorem submersionKernelProjection_spec {F : M → N} (p : M)
+    (x : (submersionDerivative (m := m) (n := n) F p).ker) :
+    submersionKernelProjection (m := m) (n := n) (F := F) p x = x := by
+  exact Classical.choose_spec
+    (submersionDerivative (m := m) (n := n) F p).ker_closedComplemented_of_finiteDimensional_range x
+
+private noncomputable def submersionCoordinateDerivativeEquiv {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    EuclideanSpace ℝ (Fin m) ≃L[ℝ] EuclideanSpace ℝ (Fin m) :=
+  ((submersionDerivative (m := m) (n := n) F p).equivProdOfSurjectiveOfIsCompl
+      (submersionKernelProjection (m := m) (n := n) (F := F) p)
+      (LinearMap.range_eq_top.mpr
+        (by simpa [submersionDerivative] using hF.surjective_mfderiv p))
+      (LinearMap.range_eq_of_proj
+        (submersionKernelProjection_spec (m := m) (n := n) (F := F) p))
+      (LinearMap.isCompl_of_proj
+        (submersionKernelProjection_spec (m := m) (n := n) (F := F) p))).trans
+    ((ContinuousLinearEquiv.refl ℝ (EuclideanSpace ℝ (Fin n))).prodCongr
+      (submersionKernelEuclideanEquiv p hF)) |>.trans
+    (submersionStandardSourceJoin p hF)
+
+private noncomputable def submersionCoordinateMap {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) :=
+  fun x => submersionStandardSourceJoin p hF
+    (writtenInExtChartAt I_m I_n p F x -
+        writtenInExtChartAt I_m I_n p F (extChartAt I_m p p),
+      submersionKernelEuclideanEquiv p hF
+        (submersionKernelProjection (m := m) (n := n) (F := F) p
+          (x - extChartAt I_m p p)))
+
+private theorem submersionCoordinateMap_zero {F : M → N} (p : M)
+    (hF : Manifold.IsSmoothSubmersion I_m I_n F) :
+    submersionCoordinateMap p hF (extChartAt I_m p p) = 0 := by
