+private theorem immersionStandardTargetSplit_symm_apply_zero {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p)
+    (u : EuclideanSpace ℝ (Fin m)) :
+    (immersionStandardTargetSplit h).symm
+        (u, (0 : EuclideanSpace ℝ (Fin (n - m)))) =
+      rank_normal_form m n m u := by
+  have hsum : m + (n - m) = n := Nat.add_sub_of_le (immersionSourceDim_le h)
+  ext i
+  simp [immersionStandardTargetSplit, rank_normal_form,
+    LinearEquiv.prodCongr_symm, LinearEquiv.prodCongr_apply,
+    WithLp.linearEquiv_apply]
+  by_cases hi : i.1 < m
+  · have hcast :
+        Fin.cast hsum.symm i = Fin.castAdd (n - m) ⟨i.1, hi⟩ := by
+      ext
+      rfl
+    rw [hcast, finSumFinEquiv_symm_apply_castAdd]
+    simp [hi]
+  · have hmi : m ≤ i.1 := Nat.le_of_not_gt hi
+    let j : Fin (n - m) := ⟨i.1 - m, by omega⟩
+    have hcast : Fin.cast hsum.symm i = Fin.natAdd m j := by
+      ext
+      simp [j]
+      omega
+    rw [hcast, finSumFinEquiv_symm_apply_natAdd]
+    simp [hi]
