+private theorem immersionComplement_finrank_eq {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+    Module.finrank ℝ h.complement = n - m := by
+  letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+  have hsum : m + Module.finrank ℝ h.complement = n := by
+    simpa only [Module.finrank_prod, finrank_euclideanSpace_fin] using
+      h.equiv.toLinearEquiv.finrank_eq
+  omega
+
+private noncomputable def immersionComplementEuclideanEquiv {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    h.complement ≃L[ℝ] EuclideanSpace ℝ (Fin (n - m)) := by
+  letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+  apply ContinuousLinearEquiv.ofFinrankEq
+  simpa only [finrank_euclideanSpace_fin] using immersionComplement_finrank_eq h
