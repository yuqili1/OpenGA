+private theorem immersionTargetLinearNormalizingEquiv_apply_writtenInCharts
+    {F : M → N} {p : M} (h : Manifold.IsImmersionAt I_m I_n ∞ F p)
+    (u : EuclideanSpace ℝ (Fin m)) :
+    immersionTargetLinearNormalizingEquiv h
+        (h.equiv (u, (0 : h.complement))) =
+      rank_normal_form m n m u := by
+  rw [immersionTargetLinearNormalizingEquiv]
+  simp only [ContinuousLinearEquiv.trans_apply,
+    ContinuousLinearEquiv.symm_apply_apply,
+    ContinuousLinearEquiv.prodCongr_apply,
+    ContinuousLinearEquiv.refl_apply,
+    map_zero]
+  exact immersionStandardTargetSplit_symm_apply_zero h u
