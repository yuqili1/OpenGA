+/- The following private helpers convert mathlib's native local normal form for an immersion,
+whose complement and linear target coordinates are abstract, into the standard Euclidean
+first-coordinate inclusion used in the statement below. -/
+
+private theorem immersionComplement_finiteDimensional {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    FiniteDimensional ℝ h.complement := by
+  let inclusion : h.complement →ₗ[ℝ] EuclideanSpace ℝ (Fin n) :=
+    h.equiv.toLinearEquiv.toLinearMap.comp
+      (LinearMap.inr ℝ (EuclideanSpace ℝ (Fin m)) h.complement)
+  refine FiniteDimensional.of_injective inclusion ?_
+  intro x y hxy
+  have hpair : ((0 : EuclideanSpace ℝ (Fin m)), x) = (0, y) := by
+    apply h.equiv.injective
+    simpa [inclusion] using hxy
+  exact congrArg Prod.snd hpair
+
+private theorem immersionSourceDim_le {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) : m ≤ n := by
+  letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+  have hsum : m + Module.finrank ℝ h.complement = n := by
+    simpa only [Module.finrank_prod, finrank_euclideanSpace_fin] using
+      h.equiv.toLinearEquiv.finrank_eq
+  omega
+
+private theorem immersionComplement_finrank_eq {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+    Module.finrank ℝ h.complement = n - m := by
+  letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+  have hsum : m + Module.finrank ℝ h.complement = n := by
+    simpa only [Module.finrank_prod, finrank_euclideanSpace_fin] using
+      h.equiv.toLinearEquiv.finrank_eq
+  omega
+
+private noncomputable def immersionComplementEuclideanEquiv {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    h.complement ≃L[ℝ] EuclideanSpace ℝ (Fin (n - m)) := by
+  letI : FiniteDimensional ℝ h.complement := immersionComplement_finiteDimensional h
+  apply ContinuousLinearEquiv.ofFinrankEq
+  simpa only [finrank_euclideanSpace_fin] using immersionComplement_finrank_eq h
+
+private noncomputable def immersionStandardTargetSplit {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    EuclideanSpace ℝ (Fin n) ≃L[ℝ]
+      EuclideanSpace ℝ (Fin m) × EuclideanSpace ℝ (Fin (n - m)) := by
+  have hsum : m + (n - m) = n := Nat.add_sub_of_le (immersionSourceDim_le h)
+  exact
+    (LinearIsometryEquiv.piLpCongrLeft 2 ℝ ℝ (finCongr hsum.symm)).toContinuousLinearEquiv.trans
+      (EuclideanSpace.finAddEquivProd (𝕜 := ℝ) (n := m) (m := n - m))
+
+private noncomputable def immersionTargetLinearNormalizingEquiv {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    EuclideanSpace ℝ (Fin n) ≃L[ℝ] EuclideanSpace ℝ (Fin n) :=
+  h.equiv.symm |>.trans
+    ((ContinuousLinearEquiv.refl ℝ (EuclideanSpace ℝ (Fin m))).prodCongr
+      (immersionComplementEuclideanEquiv h)) |>.trans
+    (immersionStandardTargetSplit h).symm
+
+private theorem immersionStandardTargetSplit_symm_apply_zero {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p)
+    (u : EuclideanSpace ℝ (Fin m)) :
+    (immersionStandardTargetSplit h).symm
+        (u, (0 : EuclideanSpace ℝ (Fin (n - m)))) =
+      rank_normal_form m n m u := by
+  have hsum : m + (n - m) = n := Nat.add_sub_of_le (immersionSourceDim_le h)
+  ext i
+  simp [immersionStandardTargetSplit, rank_normal_form,
+    LinearEquiv.prodCongr_symm, LinearEquiv.prodCongr_apply,
+    WithLp.linearEquiv_apply]
+  by_cases hi : i.1 < m
+  · have hcast :
+        Fin.cast hsum.symm i = Fin.castAdd (n - m) ⟨i.1, hi⟩ := by
+      ext
+      rfl
+    rw [hcast, finSumFinEquiv_symm_apply_castAdd]
+    simp [hi]
+  · have hmi : m ≤ i.1 := Nat.le_of_not_gt hi
+    let j : Fin (n - m) := ⟨i.1 - m, by omega⟩
+    have hcast : Fin.cast hsum.symm i = Fin.natAdd m j := by
+      ext
+      simp [j]
+      omega
+    rw [hcast, finSumFinEquiv_symm_apply_natAdd]
+    simp [hi]
+
+private theorem immersionTargetLinearNormalizingEquiv_apply_writtenInCharts
+    {F : M → N} {p : M} (h : Manifold.IsImmersionAt I_m I_n ∞ F p)
+    (u : EuclideanSpace ℝ (Fin m)) :
+    immersionTargetLinearNormalizingEquiv h
+        (h.equiv (u, (0 : h.complement))) =
+      rank_normal_form m n m u := by
+  rw [immersionTargetLinearNormalizingEquiv]
+  simp only [ContinuousLinearEquiv.trans_apply,
+    ContinuousLinearEquiv.symm_apply_apply,
+    ContinuousLinearEquiv.prodCongr_apply,
+    ContinuousLinearEquiv.refl_apply,
+    map_zero]
+  exact immersionStandardTargetSplit_symm_apply_zero h u
+
+private theorem immersionTranslation_mem_contDiffGroupoid
+    {k : ℕ} (v : EuclideanSpace ℝ (Fin k)) :
+    (Homeomorph.addRight v).toOpenPartialHomeomorph ∈ contDiffGroupoid ∞
+      (𝓘(ℝ, EuclideanSpace ℝ (Fin k))) := by
+  rw [contDiffGroupoid, mem_groupoid_of_pregroupoid, contDiffPregroupoid]
+  constructor
+  · simpa [modelWithCornersSelf_coe, Homeomorph.addRight] using
+      (contDiff_id.add contDiff_const).contDiffOn
+  · simpa [modelWithCornersSelf_coe, Homeomorph.addRight] using
+      (contDiff_id.add contDiff_const).contDiffOn
+
+private theorem immersionLinearEquiv_mem_contDiffGroupoid
+    {k : ℕ} (L : EuclideanSpace ℝ (Fin k) ≃L[ℝ] EuclideanSpace ℝ (Fin k)) :
+    L.toHomeomorph.toOpenPartialHomeomorph ∈ contDiffGroupoid ∞
+      (𝓘(ℝ, EuclideanSpace ℝ (Fin k))) := by
+  rw [contDiffGroupoid, mem_groupoid_of_pregroupoid, contDiffPregroupoid]
+  constructor
+  · simpa [modelWithCornersSelf_coe] using L.contDiff.contDiffOn
+  · simpa [modelWithCornersSelf_coe] using L.symm.contDiff.contDiffOn
+
+private noncomputable def immersionCenteredDomainChart {F : M → N} {p : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    OpenPartialHomeomorph M (EuclideanSpace ℝ (Fin m)) :=
+  h.domChart.transHomeomorph (Homeomorph.addRight (-h.domChart p))
+
+private noncomputable def immersionCenteredNormalizingCodomainChart
+    {F : M → N} {p : M} (h : Manifold.IsImmersionAt I_m I_n ∞ F p) :
+    OpenPartialHomeomorph N (EuclideanSpace ℝ (Fin n)) :=
+  (h.codChart.transHomeomorph
+      (immersionTargetLinearNormalizingEquiv h).toHomeomorph).transHomeomorph
+    (Homeomorph.addRight (-(rank_normal_form m n m (h.domChart p))))
+
+private theorem immersionWrittenOnChartSource {F : M → N} {p y : M}
+    (h : Manifold.IsImmersionAt I_m I_n ∞ F p)
+    (hy : y ∈ h.domChart.source) :
+    h.codChart (F y) = h.equiv (h.domChart y, (0 : h.complement)) := by
+  let u : EuclideanSpace ℝ (Fin m) := (h.domChart.extend I_m) y
+  have hu : u ∈ (h.domChart.extend I_m).target :=
+    (h.domChart.extend I_m).map_source
+      (by simpa [OpenPartialHomeomorph.extend_source] using hy)
+  have hw := h.writtenInCharts hu
+  have hleft : h.domChart.symm (h.domChart y) = y := h.domChart.left_inv hy
+  simpa [u, Function.comp, OpenPartialHomeomorph.extend_coe,
+    OpenPartialHomeomorph.extend_coe_symm, modelWithCornersSelf_coe,
+    modelWithCornersSelf_coe_symm, hleft] using hw
+
+private theorem rank_normal_form_full_add
+    (x y : EuclideanSpace ℝ (Fin m)) :
+    rank_normal_form m n m (x + y) =
+      rank_normal_form m n m x + rank_normal_form m n m y := by
+  ext i
+  simp only [rank_normal_form, PiLp.add_apply]
+  by_cases hi : i.1 < m
+  · simp [hi]
+  · simp [hi]
+
