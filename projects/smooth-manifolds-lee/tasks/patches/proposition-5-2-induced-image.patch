+@[implicit_reducible]
+private def pullbackChartedSpace {H X Y : Type*} [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    (e : X ≃ₜ Y) : ChartedSpace H X where
+  atlas := e.transOpenPartialHomeomorph '' atlas H Y
+  chartAt x := e.transOpenPartialHomeomorph (chartAt H (e x))
+  mem_chart_source x := by simp
+  chart_mem_atlas x := ⟨chartAt H (e x), chart_mem_atlas H (e x), rfl⟩
+
+@[simp]
+private theorem pullbackChartedSpace_chartAt {H X Y : Type*} [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    (e : X ≃ₜ Y) (x : X) :
+    @chartAt H _ X _ (pullbackChartedSpace e) x =
+      e.transOpenPartialHomeomorph (chartAt H (e x)) := rfl
+
+private theorem pullback_transition {H X Y : Type*} [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] (e : X ≃ₜ Y)
+    (a b : OpenPartialHomeomorph Y H) :
+    (e.transOpenPartialHomeomorph a).symm ≫ₕ e.transOpenPartialHomeomorph b =
+      a.symm ≫ₕ b := by
+  apply OpenPartialHomeomorph.ext <;> simp [Function.comp_def, Set.ext_iff]
+
+@[implicit_reducible]
+private def pullbackHasGroupoid {H X Y : Type*} [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    (e : X ≃ₜ Y) (G : StructureGroupoid H) [HasGroupoid Y G] :
+    @HasGroupoid H _ X _ (pullbackChartedSpace e) G := by
+  letI : ChartedSpace H X := pullbackChartedSpace e
+  exact ⟨by
+    rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
+    rw [pullback_transition e a b]
+    exact G.compatible ha hb⟩
+
+private theorem pullback_mem_maximalAtlas {H X Y : Type*} [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    (e : X ≃ₜ Y) (G : StructureGroupoid H)
+    {a : OpenPartialHomeomorph Y H} (ha : a ∈ G.maximalAtlas Y) :
+    let _ : ChartedSpace H X := pullbackChartedSpace e
+    e.transOpenPartialHomeomorph a ∈ G.maximalAtlas X := by
+  letI : ChartedSpace H X := pullbackChartedSpace e
+  change e.transOpenPartialHomeomorph a ∈ G.maximalAtlas X
+  rintro _ ⟨b, hb, rfl⟩
+  simpa only [pullback_transition e a b, pullback_transition e b a] using ha b hb
+
+private theorem contMDiff_pullbackHomeomorph
+    {𝕜 E H X Y : Type*} [NontriviallyNormedField 𝕜]
+    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    {I : ModelWithCorners 𝕜 E H} {n : ℕ∞ω} (e : X ≃ₜ Y) :
+    let _ : ChartedSpace H X := pullbackChartedSpace e
+    ContMDiff I I n e := by
+  letI : ChartedSpace H X := pullbackChartedSpace e
+  change ContMDiff I I n e
+  intro x
+  rw [contMDiffAt_iff_target]
+  refine ⟨e.continuous.continuousAt, ?_⟩
+  simpa [extChartAt, OpenPartialHomeomorph.extend, pullbackChartedSpace,
+    Function.comp_def] using (contMDiffAt_extChartAt (I := I) (x := x))
+
+private theorem contMDiff_pullbackHomeomorph_symm
+    {𝕜 E H X Y : Type*} [NontriviallyNormedField 𝕜]
+    [NormedAddCommGroup E] [NormedSpace 𝕜 E] [TopologicalSpace H]
+    [TopologicalSpace X] [TopologicalSpace Y] [ChartedSpace H Y]
+    {I : ModelWithCorners 𝕜 E H} {n : ℕ∞ω} (e : X ≃ₜ Y) :
+    let _ : ChartedSpace H X := pullbackChartedSpace e
+    ContMDiff I I n e.symm := by
+  letI : ChartedSpace H X := pullbackChartedSpace e
+  change ContMDiff I I n e.symm
+  intro y
+  rw [contMDiffAt_iff_target]
+  refine ⟨e.symm.continuous.continuousAt, ?_⟩
+  simpa [extChartAt, OpenPartialHomeomorph.extend, pullbackChartedSpace,
+    Function.comp_def] using (contMDiffAt_extChartAt (I := I) (x := y))
+
