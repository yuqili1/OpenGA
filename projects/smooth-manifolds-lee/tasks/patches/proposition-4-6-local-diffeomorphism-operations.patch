+private def partialDiffeomorphTrans
+    (Φ : PartialDiffeomorph I J M N n) (Ψ : PartialDiffeomorph J K N P n) :
+    PartialDiffeomorph I K M P n where
+  toPartialEquiv := Φ.toPartialEquiv.trans Ψ.toPartialEquiv
+  open_source := (Φ.toOpenPartialHomeomorph.trans Ψ.toOpenPartialHomeomorph).open_source
+  open_target := (Φ.toOpenPartialHomeomorph.trans Ψ.toOpenPartialHomeomorph).open_target
+  contMDiffOn_toFun := Ψ.contMDiffOn_toFun.comp' Φ.contMDiffOn_toFun
+  contMDiffOn_invFun := Φ.contMDiffOn_invFun.comp' Ψ.contMDiffOn_invFun
+
