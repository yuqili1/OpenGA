{
  "name": "@openga/review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy-tasks": "node scripts/copy-tasks.js",
    "generate-lee-tasks": "node scripts/generate-lee-tasks.js",
    "generate-lee-formal-triage": "node scripts/generate-lee-formal-triage.js",
    "generate-lee-deps": "node scripts/generate-lee-deps.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build:static": "VITE_STATIC=1 vite build && VITE_STATIC=1 tsx scripts/generate-static.mts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "js-yaml": "^5.2.0",
    "katex": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^10.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
